<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Node Express Task Manager</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <main class="container">
    <h1>Node Express Task Manager</h1>

    <section class="card">
      <h2 id="form-title">Create Task</h2>

      <div id="error-message" class="error hidden"></div>

      <form id="task-form">
        <input type="hidden" id="task-id" />

        <label for="title">Title</label>
        <input type="text" id="title" placeholder="Enter task title" required />

        <label for="description">Description</label>
        <textarea id="description" placeholder="Enter task description"></textarea>

        <label for="status">Status</label>
        <select id="status">
          <option value="todo">Todo</option>
          <option value="doing">Doing</option>
          <option value="done">Done</option>
        </select>

        <label for="dueDate">Due Date</label>
        <input type="date" id="dueDate" />

        <div class="actions">
          <button type="submit">Save Task</button>
          <button type="button" id="cancel-edit" class="secondary hidden">Cancel</button>
        </div>
      </form>
    </section>

    <section class="card">
      <h2>Your Tasks</h2>
      <div id="task-list"></div>
    </section>
  </main>

  <script src="/app.js"></script>
</body>
</html>